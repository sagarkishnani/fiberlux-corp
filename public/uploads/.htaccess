# Bloquea el acceso HTTP directo a los adjuntos subidos (documentos de identidad) — SPEC 85.
# Cubre Apache 2.4 (mod_authz_core) y 2.2. No afecta a send-email.php, que escribe por
# sistema de archivos; el panel solo muestra nombre y tamaño, nunca enlaza a uploads/.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
