# Bloquea el acceso HTTP directo a los leads (data/submissions, counter, deleted*) — SPEC 85.
# Cubre Apache 2.4 (mod_authz_core) y 2.2. No afecta a send-email.php/panel-leads.php,
# que leen y escriben por sistema de archivos, no por HTTP.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
