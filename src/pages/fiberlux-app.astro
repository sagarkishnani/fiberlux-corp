---
import BaseLayout from "../layouts/BaseLayout.astro";
import { client } from "../../tina/__generated__/client";
import FiberluxAppV2React from "../components/fiberlux-app/FiberluxAppV2React";
import HomeTestimoniosReact from "../components/home/HomeTestimoniosReact";
import { getLocale } from "../utils/i18n";
import { isLocale } from "../i18n/config";

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocale(Astro.url);

const [appQuery, homeQuery, globalQuery] = await Promise.all([
  client.queries.fiberluxApp({ relativePath: "index.json" }),
  client.queries.home({ relativePath: "index.json" }),
  client.queries.global({ relativePath: "index.json" }),
]);
const app = appQuery.data?.fiberluxApp;
const globalSeo = globalQuery.data?.global?.seo;
const homeProps = { query: homeQuery.query, variables: homeQuery.variables, data: homeQuery.data, locale };

const metaTitle = app?.seo?.metaTitle || app?.hero?.heading || "Fiberlux App";
const metaDescription = app?.seo?.metaDescription || globalSeo?.defaultDescription || undefined;
---

<BaseLayout title={metaTitle} description={metaDescription}>
  <main class="bg-fx-bg">
    <FiberluxAppV2React
      client:load
      query={appQuery.query}
      variables={appQuery.variables}
      data={appQuery.data}
      locale={locale}
    />
    <HomeTestimoniosReact client:visible {...homeProps} withCta />
  </main>
</BaseLayout>
