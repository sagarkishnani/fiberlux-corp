---
import BaseLayout from "../layouts/BaseLayout.astro";
import { client } from "../../tina/__generated__/client";
import HeroFiberluxApp from "../components/fiberlux-app/HeroFiberluxApp.astro";
import BeneficiosApp from "../components/fiberlux-app/BeneficiosApp.astro";
import CasosDeUsoApp from "../components/fiberlux-app/CasosDeUsoApp.astro";
import Stats from "../components/Stats.astro";
import BlogPreview from "../components/blog/BlogPreview.astro";

/* ── SEO / meta (falls back to global.seo) ── */
const appQuery = await client.queries.fiberluxApp({
  relativePath: "index.json",
});
const app = appQuery.data?.fiberluxApp;

const globalQuery = await client.queries.global({ relativePath: "index.json" });
const globalSeo = globalQuery.data?.global?.seo;

const metaTitle = app?.seo?.metaTitle || app?.hero?.heading || "Fiberlux App";
const metaDescription =
  app?.seo?.metaDescription || globalSeo?.defaultDescription || undefined;
---

<BaseLayout title={metaTitle} description={metaDescription}>
  <main>
    {/* Overlap sticky (SPEC 70): el hero queda fijo y Beneficios sube por
        encima cubriéndolo; el hero se libera al terminar la sección. */}
    <div class="relative">
      <div class="sticky top-0 z-0" data-hero-sticky>
        <HeroFiberluxApp />
      </div>
      <div class="relative z-10">
        <BeneficiosApp />
      </div>
    </div>
    <div data-reveal="up">
      <CasosDeUsoApp />
    </div>
    <div class="-mt-16 relative z-20" data-reveal="up">
      <Stats title={app?.whyUsTitle ?? undefined} />
    </div>
    <div class="-mt-16 relative z-20" data-reveal="up">
      <BlogPreview />
    </div>
  </main>
</BaseLayout>
