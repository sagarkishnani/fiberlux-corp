---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroSoporte from "../../components/soporte/HeroSoporte.astro";
import CanalesSoporte from "../../components/soporte/CanalesSoporte.astro";
import SolucionesStack from "../../components/shared/SolucionesStack.astro";
import EmpresasRed from "../../components/home/EmpresasRed.astro";
---

<BaseLayout
  title="Soporte técnico"
  description="Contáctate con nuestros ingenieros especializados. Soporte técnico de Fiberlux Corp por WhatsApp, llamada o correo."
>
  <main>
    <HeroSoporte />
    <div data-reveal="up">
      <CanalesSoporte />
    </div>
    <SolucionesStack />
    {/* Fondo negro detrás del panel claro de cifras + testimonios: sus esquinas
        superiores redondeadas dejan ver este fondo (aquí el <main> no es oscuro
        como en home). */}
    <div class="-mt-2 relative z-25 bg-greyscale-darkest" data-reveal="up">
      <EmpresasRed />
    </div>
  </main>
</BaseLayout>
