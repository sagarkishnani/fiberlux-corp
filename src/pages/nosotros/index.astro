---
// src/pages/nosotros.astro
import { client } from "../../../tina/__generated__/client";
import BaseLayout from "../../layouts/BaseLayout.astro";
import MissionVisionReact from "../../components/nosotros/MissionVisionReact.tsx";
import ValuesReact from "../../components/nosotros/ValuesReact.tsx";
import HeroNosotrosReact from "../../components/nosotros/HeroNosotrosReact";
import TimelineReact from "../../components/nosotros/TimelineReact.tsx";
import StatsReact from "../../components/StatsReact";
import RubrosReact from "../../components/nosotros/RubrosReact.tsx";
import CertificacionesSlider from "../../components/certificaciones/CertificacionesSlider.astro";
import BannerApp from "../../components/fiberlux-app/BannerApp.astro";

const aboutQuery = await client.queries.about({ relativePath: "index.json" });
const homeQuery = await client.queries.home({ relativePath: "index.json" });
const globalQuery = await client.queries.global({ relativePath: "index.json" });
const rubrosCfg = (globalQuery.data?.global as any)?.sliders?.rubros ?? {};
---

<BaseLayout title="Nosotros">
  <HeroNosotrosReact
    client:load
    query={aboutQuery.query}
    variables={aboutQuery.variables}
    data={aboutQuery.data}
  />
  <MissionVisionReact
    client:load
    query={aboutQuery.query}
    variables={aboutQuery.variables}
    data={aboutQuery.data}
  />
  <ValuesReact
    client:load
    query={aboutQuery.query}
    variables={aboutQuery.variables}
    data={aboutQuery.data}
  />
  <TimelineReact
    client:visible
    query={aboutQuery.query}
    variables={aboutQuery.variables}
    data={aboutQuery.data}
  />
  <div class="-mt-16 relative z-20" data-reveal="up">
    <StatsReact
      client:visible
      query={homeQuery.query}
      variables={homeQuery.variables}
      data={homeQuery.data}
    />
  </div>
  <div class="-mt-4 relative z-30" data-reveal="up">
    <RubrosReact
      client:visible
      query={aboutQuery.query}
      variables={aboutQuery.variables}
      data={aboutQuery.data}
      autoplay={rubrosCfg.autoplay ?? true}
      intervalMs={rubrosCfg.intervalMs ?? 3500}
      effect={rubrosCfg.effect ?? "none"}
    />
  </div>
  <div data-reveal="up">
    <BannerApp />
  </div>
  <div data-reveal="up">
    <CertificacionesSlider />
  </div>
</BaseLayout>
