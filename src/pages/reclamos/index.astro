---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReclamosSelectorReact from "../../components/reclamos/ReclamosSelectorReact";
import { getLocale } from "../../utils/i18n";
import { isLocale } from "../../i18n/config";

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocale(Astro.url);
---

<BaseLayout
  title="Reclamos"
  description="Formularios de reclamo, apelación y queja ante OSIPTEL."
  footerOverlap
>
  <main class="bg-fx-bg">
    <ReclamosSelectorReact locale={locale} />
  </main>
</BaseLayout>
