---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { client } from "../../../tina/__generated__/client";
import HeroCasos from "../../components/casos-de-exito/HeroCasos.astro";
import CasosSlider from "../../components/casos-de-exito/CasosSlider.astro";
import EmpresasRedReact from "../../components/home/EmpresasRedReact";
import RubrosReact from "../../components/nosotros/RubrosReact.tsx";
import { getLocale } from "../../utils/i18n";
import { isLocale } from "../../i18n/config";

const casosQuery = await client.queries.casosDeExito({
  relativePath: "index.json",
});
/* Rubros (mismo bloque editable que Nosotros): cierra la página de casos con
   los sectores a los que atiende Fiberlux. */
const aboutQuery = await client.queries.about({ relativePath: "index.json" });
/* "Empresas que confían en nuestra red": cifras + testimonios, el mismo bloque
   del home/nosotros. Va entre el slider de casos y los rubros. */
const homeQuery = await client.queries.home({ relativePath: "index.json" });
const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocale(Astro.url);
const page = casosQuery.data.casosDeExito;
const seo = page?.seo;

const title = seo?.metaTitle || page?.heading || "Casos de éxito";
const description =
  seo?.metaDescription ||
  "Conoce cómo empresas líderes potencian su conectividad, seguridad y comunicación con las soluciones de Fiberlux Corp.";
---

<BaseLayout title={title} description={description}>
  <main>
    <HeroCasos />
    <CasosSlider />
    {/* Fondo negro detrás del panel claro: sus esquinas superiores redondeadas
        dejan ver lo que hay detrás. */}
    <div class="relative bg-greyscale-darkest" data-reveal="up" data-overlap-rise>
      <EmpresasRedReact
        client:visible
        query={homeQuery.query}
        variables={homeQuery.variables}
        data={homeQuery.data}
        locale={locale}
        effect="none"
        hideCta
      />
    </div>
    {/* Los rubros suben sobre el panel claro: sus esquinas superiores
        redondeadas cierran el bloque, igual que en Nosotros. Sin `glow`: aquí
        el fondo va plano, sin el degradado morado. */}
    <div class="-mt-4 relative z-30" data-reveal="up">
      <RubrosReact
        client:visible
        query={aboutQuery.query}
        variables={aboutQuery.variables}
        data={aboutQuery.data}
        locale={locale}
      />
    </div>
    {/* Aire extra antes del footer: aquí los rubros cierran la página (en
        Nosotros les sigue el slider de certificaciones). Mismo negro que la
        sección para que la transición sea invisible. */}
    <div class="relative z-30 h-12 bg-[#0a0a0a] md:h-20" aria-hidden="true"></div>
  </main>
</BaseLayout>
