---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { client } from "../../../tina/__generated__/client";
import CasosV2React from "../../components/casos-de-exito/CasosV2React";
import { getLocale } from "../../utils/i18n";
import { isLocale } from "../../i18n/config";

const [casosQuery, aboutQuery] = await Promise.all([
  client.queries.casosDeExito({ relativePath: "index.json" }),
  client.queries.about({ relativePath: "index.json" }),
]);
const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocale(Astro.url);
const page = casosQuery.data.casosDeExito;
const seo = page?.seo;
const about = aboutQuery.data?.about as any;
const stats = ((about?.stats?.items || []).filter(Boolean) as any[]).slice(0, 4);

const title = seo?.metaTitle || page?.heading || "Casos de éxito";
const description =
  seo?.metaDescription ||
  "Conoce cómo empresas líderes potencian su conectividad, seguridad y comunicación con las soluciones de Fiberlux Corp.";
---

<BaseLayout title={title} description={description} footerOverlap>
  <main class="bg-fx-bg">
    <CasosV2React
      client:visible
      query={casosQuery.query}
      variables={casosQuery.variables}
      data={casosQuery.data}
      locale={locale}
      stats={stats}
      rubros={about?.rubros ?? null}
    />
  </main>
</BaseLayout>
