---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHeroReact from "../components/home/HomeHeroReact";
import HomeStatsReact from "../components/home/HomeStatsReact";
import HomeReelReact from "../components/home/HomeReelReact";
import HomeSolucionesReact from "../components/home/HomeSolucionesReact";
import HomeManifestoReact from "../components/home/HomeManifestoReact";
import HomeCyberguardReact from "../components/home/HomeCyberguardReact";
import BlogPreview from "../components/blog/BlogPreview.astro";
import EmpresasRed from "../components/home/EmpresasRed.astro";
import HomePartners from "../components/shared/HomePartners.astro";
import CertificacionesSlider from "../components/certificaciones/CertificacionesSlider.astro";
import HtmlInjection from "../components/shared/HtmlInjection.astro";
import client from "../../tina/__generated__/client";
import { getLocale } from "../utils/i18n";
import { isLocale } from "../i18n/config";

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocale(Astro.url);
const homeQuery = await client.queries.home({ relativePath: "index.json" });
const homeProps = { query: homeQuery.query, variables: homeQuery.variables, data: homeQuery.data, locale };
---

<BaseLayout title="Inicio">
  <main class="bg-fx-bg">
    <HomeHeroReact client:load {...homeProps} />
    <HomeStatsReact client:tina {...homeProps} />
    <HomeReelReact client:visible {...homeProps} />
    <HtmlInjection location="home-after-hero" />
    <HomeSolucionesReact client:visible {...homeProps} />
    <HomeManifestoReact client:visible {...homeProps} />
    <HomeCyberguardReact client:tina {...homeProps} />
    <HomePartners />
    <EmpresasRed />
    <CertificacionesSlider />
    <BlogPreview />
    <HtmlInjection location="home-before-footer" />
  </main>
</BaseLayout>
