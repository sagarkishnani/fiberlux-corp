---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroHome from "../components/home/HeroHome.astro";
import BlogPreview from "../components/blog/BlogPreview.astro";
// StickyCards: bloque de soluciones anterior (apilamiento sticky). Reemplazado
// por SolucionesSlider (SPEC 35). Se conserva comentado para reutilizarlo luego.
// import StickyCards from "../components/shared/StickyCards.astro";
import SolucionesStack from "../components/shared/SolucionesStack.astro";
import EmpresasRed from "../components/home/EmpresasRed.astro";
import HomePartners from "../components/shared/HomePartners.astro";
import CertificacionesSlider from "../components/certificaciones/CertificacionesSlider.astro";
import BannerApp from "../components/fiberlux-app/BannerApp.astro";
import HtmlInjection from "../components/shared/HtmlInjection.astro";
// SitePreloader: pantalla de bienvenida que tapaba la carga de la escena Spline
// del hero (modo `heroBackground: "3d"`). Desactivado: hoy el hero va en modo
// "cinematic", cuyo fondo WebGL avisa que está listo a los ~0.25 s, así que el
// loader sólo añadía ~1.8 s de espera (mínimo visible + wipe) sobre algo ya
// pintado, y duplicaba la intro FLX→FIBERLUX, que ya es la entrada de marca.
// El componente se conserva por si se vuelve al hero 3D.
// import SitePreloader from "../components/shared/SitePreloader";
import serviciosContent from "../content/servicios/index.json";
import soporteContent from "../content/soporte-tecnico/index.json";

// URLs .splinecode de las otras páginas con 3D. Se precargan en idle para
// calentar la caché HTTP: aunque las navegaciones ya no recargan el documento
// (View Transitions, SPEC 110), la isla de esas páginas descarga su escena al
// montarse, y con la caché caliente aparece de inmediato.
const prefetchScenes = [
  serviciosContent.splineSceneUrl,
  soporteContent.splineSceneUrl,
].filter(Boolean);
---

<BaseLayout title="Inicio">
  {/* Prefetch en idle de las escenas de Servicios/Soporte, tras cargar la de
      Home, para que esas páginas abran con la caché HTTP caliente. */}
  <script is:inline define:vars={{ prefetchScenes }}>
    (function () {
      if (!prefetchScenes || !prefetchScenes.length) return;
      var done = false;
      var run = function () {
        if (done) return;
        done = true;
        var go = function () {
          prefetchScenes.forEach(function (u) {
            try {
              fetch(u, { mode: "no-cors", cache: "force-cache" });
            } catch (e) {}
          });
        };
        if ("requestIdleCallback" in window)
          requestIdleCallback(go, { timeout: 3000 });
        else setTimeout(go, 2000);
      };
      // Espera a que la escena de Home termine (o falle) para no competir.
      window.addEventListener("fbx:hero-scene-loaded", run, { once: true });
      // Respaldo por si el evento no llega (Home sin 3D, etc.).
      setTimeout(run, 5000);
    })();
  </script>

  <main class="bg-greyscale-darkest">
    {/* -mt-16 hace que el hero se solape con el HeaderReact transparente */}
    <div class="-mt-16">
      <HeroHome />
    </div>
    <HtmlInjection location="home-after-hero" />
    <div class="-mt-16 relative z-10">
      {/* <StickyCards /> → SolucionesSlider (SPEC 35) → SolucionesScroll (SPEC 89) → SolucionesPanel (SPEC 103) →
          SolucionesStack (SPEC 108) */}
      <SolucionesStack />
    </div>
    {/* Orden agrupado por color: los oscuros (Soluciones → Partners) juntos y
        luego el panel claro. Cifras y testimonios van en un solo bloque
        (`EmpresasRed`), antes eran dos secciones seguidas. */}
    <div class="relative z-20" data-reveal="up">
      <HomePartners />
    </div>
    <div class="-mt-2 relative z-30" data-reveal="up" data-overlap-rise>
      <EmpresasRed />
    </div>
    <div class="relative z-20" data-reveal="up">
      <CertificacionesSlider />
    </div>
    <div class="relative z-20" data-reveal="up">
      <BannerApp />
    </div>
    <div class="-mt-6 relative z-30" data-reveal="up">
      <BlogPreview />
    </div>
    <HtmlInjection location="home-before-footer" />
  </main>
</BaseLayout>
