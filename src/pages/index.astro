---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHeroReact from "../components/home/HomeHeroReact";
import HomeStatsReact from "../components/home/HomeStatsReact";
import HomeReelReact from "../components/home/HomeReelReact";
import HomeSolucionesReact from "../components/home/HomeSolucionesReact";
import HomeManifestoReact from "../components/home/HomeManifestoReact";
import HomeCyberguardReact from "../components/home/HomeCyberguardReact";
import HomePartnersV2 from "../components/home/HomePartnersV2.astro";
import HomeTestimoniosReact from "../components/home/HomeTestimoniosReact";
import HomeCertificacionesReact from "../components/home/HomeCertificacionesReact";
import HomeInsightsReact, { type InsightPost } from "../components/home/HomeInsightsReact";
import HtmlInjection from "../components/shared/HtmlInjection.astro";
import client from "../../tina/__generated__/client";
import { getLocale } from "../utils/i18n";
import { isLocale } from "../i18n/config";
import { loadCertificaciones } from "../utils/certificaciones";

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocale(Astro.url);
const [homeQuery, certificaciones, postsQuery] = await Promise.all([
  client.queries.home({ relativePath: "index.json" }),
  loadCertificaciones(),
  client.queries.postConnection({ first: 50, sort: "date" }),
]);
const homeProps = { query: homeQuery.query, variables: homeQuery.variables, data: homeQuery.data, locale };

const posts: InsightPost[] = ((postsQuery.data?.postConnection?.edges || []) as any[])
  .map((e) => e?.node)
  .filter(Boolean)
  .sort((a, b) => new Date(b.date || 0).getTime() - new Date(a.date || 0).getTime())
  .slice(0, 3)
  .map((p) => ({
    title: p.title ?? null,
    title_en: p.title_en ?? null,
    coverImage: p.coverImage ?? null,
    tags: p.tags ?? null,
    readTime: p.readTime ?? null,
    date: p.date ?? null,
    slug: p._sys.filename,
  }));
---

<BaseLayout title="Inicio">
  <main class="bg-fx-bg">
    <HomeHeroReact client:load {...homeProps} />
    <HomeStatsReact client:tina {...homeProps} />
    <HomeReelReact client:visible {...homeProps} />
    <HtmlInjection location="home-after-hero" />
    <HomeSolucionesReact client:visible {...homeProps} />
    <HomeManifestoReact client:visible {...homeProps} />
    <HomeCyberguardReact client:tina {...homeProps} />
    <HomePartnersV2 locale={locale} />
    <HomeTestimoniosReact client:visible {...homeProps} />
    <HomeCertificacionesReact client:visible {...homeProps} certificaciones={certificaciones} />
    <HomeInsightsReact client:tina {...homeProps} posts={posts} />
    <HtmlInjection location="home-before-footer" />
  </main>
</BaseLayout>
