---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { client } from "../../../tina/__generated__/client";
import FormasPagoV2React from "../../components/formas-de-pago/FormasPagoV2React";
import { getLocale } from "../../utils/i18n";
import { isLocale } from "../../i18n/config";

const formasQuery = await client.queries.formasDePago({ relativePath: "index.json" });
const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocale(Astro.url);
const page = formasQuery.data.formasDePago;
const seo = page?.seo;

const title = seo?.metaTitle || page?.heading || "Formas de pago";
const description =
  seo?.metaDescription ||
  "Aprende a pagar tus facturas de Fiberlux desde tu banco de forma sencilla, paso a paso.";
---

<BaseLayout title={title} description={description} footerOverlap>
  <main class="bg-fx-bg">
    <FormasPagoV2React
      client:load
      query={formasQuery.query}
      variables={formasQuery.variables}
      data={formasQuery.data}
      locale={locale}
    />
  </main>
</BaseLayout>
