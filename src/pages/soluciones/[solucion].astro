---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { client } from "../../../tina/__generated__/client";
import CategoriaV2React from "../../components/servicios/CategoriaV2React";
import CategoriaCierreReact from "../../components/servicios/CategoriaCierreReact";
import { loadRelatedPosts, loadServiciosForm } from "../../utils/relatedPosts";
import HtmlInjection from "../../components/shared/HtmlInjection.astro";
import { getLocale } from "../../utils/i18n";
import { isLocale } from "../../i18n/config";

/* ── Static paths from all solution documents ── */
export async function getStaticPaths() {
  let paths: { params: { solucion: string } }[] = [];
  try {
    const conn = await client.queries.serviceConnection({ last: 100 });
    const edges = conn.data?.serviceConnection?.edges || [];
    paths = edges
      .filter((e: any) => e?.node)
      .map((e: any) => ({ params: { solucion: e!.node!._sys.filename } }));
  } catch {
    paths = [];
  }
  return paths;
}

const { solucion } = Astro.params;
const relativePath = `${solucion}.json`;

/* ── SEO / meta (per-service, falls back to global.seo) ── */
const serviceQuery = await client.queries.service({ relativePath });
const service = serviceQuery.data?.service;
const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocale(Astro.url);

const [relatedPosts, serviciosForm] = await Promise.all([loadRelatedPosts(service?.blogTags), loadServiciosForm()]);

const globalQuery = await client.queries.global({ relativePath: "index.json" });
const globalSeo = globalQuery.data?.global?.seo;

const metaTitle = service?.seo?.metaTitle || service?.title || "Soluciones";
const metaDescription =
  service?.seo?.metaDescription || globalSeo?.defaultDescription || undefined;
---

<BaseLayout
  footerOverlap
  title={metaTitle}
  description={metaDescription}
  whatsappContext={service?.title ?? undefined}
  whatsappKind="solución"
>
  <main class="bg-fx-bg">
    <CategoriaV2React
      client:load
      query={serviceQuery.query}
      variables={serviceQuery.variables}
      data={serviceQuery.data}
      locale={locale}
    />
    <HtmlInjection location="solucion-after-hero" />
    <CategoriaCierreReact
      client:visible
      query={serviceQuery.query}
      variables={serviceQuery.variables}
      data={serviceQuery.data}
      locale={locale}
      posts={relatedPosts}
      form={serviciosForm}
    />
    <HtmlInjection location="solucion-before-footer" />
  </main>
</BaseLayout>
