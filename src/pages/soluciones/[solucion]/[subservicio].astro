---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { client } from "../../../../tina/__generated__/client";
import SolucionV2React from "../../../components/servicios/SolucionV2React";
import { loadServiciosForm } from "../../../utils/relatedPosts";
import HtmlInjection from "../../../components/shared/HtmlInjection.astro";
import { getLocale } from "../../../utils/i18n";
import { isLocale } from "../../../i18n/config";

/* ── Static paths from all sub-service documents ── */
export async function getStaticPaths() {
  let paths: { params: { solucion: string; subservicio: string } }[] = [];
  try {
    const conn = await client.queries.subservicioConnection({ last: 200 });
    const edges = conn.data?.subservicioConnection?.edges || [];
    paths = edges
      .filter((e: any) => e?.node?.solucionSlug)
      .map((e: any) => ({
        params: {
          solucion: e!.node!.solucionSlug as string,
          subservicio: e!.node!._sys.filename,
        },
      }));
  } catch {
    paths = [];
  }
  return paths;
}

const { subservicio } = Astro.params;
const relativePath = `${subservicio}.json`;

/* ── SEO / meta (per-subservicio, falls back to global.seo) ── */
const subQuery = await client.queries.subservicio({ relativePath });
const sub = subQuery.data?.subservicio;
const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocale(Astro.url);

const [parentQuery, homeQuery, serviciosForm] = await Promise.all([
  client.queries.service({ relativePath: `${sub?.solucionSlug}.json` }).catch(() => null),
  client.queries.home({ relativePath: "index.json" }),
  loadServiciosForm(),
]);
const parent = parentQuery?.data?.service as any;
const category = {
  title: parent?.title || sub?.solucionTitle || "",
  title_en: parent?.title_en ?? null,
  href: `/soluciones/${sub?.solucionSlug}`,
};
const siblings = ((parent?.catalogo?.items || []) as any[])
  .filter((item) => item?.url && !item.url.endsWith(`/${subservicio}`))
  .map((item) => ({ title: item.title, title_en: item.title_en ?? null, url: item.url }));
const testimonials = ((homeQuery.data?.home?.testimonials?.items || []) as any[]).filter(Boolean);

const globalQuery = await client.queries.global({ relativePath: "index.json" });
const globalSeo = globalQuery.data?.global?.seo;

const metaTitle = sub?.seo?.metaTitle || sub?.title || "Servicios";
const metaDescription =
  sub?.seo?.metaDescription || globalSeo?.defaultDescription || undefined;
---

<BaseLayout
  footerOverlap
  title={metaTitle}
  description={metaDescription}
  whatsappContext={sub?.title ?? undefined}
  whatsappKind="servicio"
>
  <main class="bg-fx-bg">
    <SolucionV2React
      client:load
      query={subQuery.query}
      variables={subQuery.variables}
      data={subQuery.data}
      locale={locale}
      category={category}
      siblings={siblings}
      testimonials={testimonials}
      form={serviciosForm}
    />
    <HtmlInjection location="subservicio-before-footer" />
  </main>
</BaseLayout>
