---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/shared/fx/PageHero";
import HomeSolucionesReact from "../../components/home/HomeSolucionesReact";
import HomePartnersV2 from "../../components/home/HomePartnersV2.astro";
import HomeCertificacionesReact from "../../components/home/HomeCertificacionesReact";
import { ServiceFormSection } from "../../components/servicios/CategoriaCierreReact";
import client from "../../../tina/__generated__/client";
import { getLocale, tField } from "../../utils/i18n";
import { isLocale } from "../../i18n/config";
import { loadCertificaciones } from "../../utils/certificaciones";
import { loadServiciosForm } from "../../utils/relatedPosts";

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocale(Astro.url);
const [serviciosQuery, homeQuery, certificaciones, serviciosForm] = await Promise.all([
  client.queries.servicios({ relativePath: "index.json" }),
  client.queries.home({ relativePath: "index.json" }),
  loadCertificaciones(),
  loadServiciosForm(),
]);
const page = serviciosQuery.data?.servicios as any;
const homeProps = { query: homeQuery.query, variables: homeQuery.variables, data: homeQuery.data, locale };
---

<BaseLayout
  title="Soluciones"
  description="Conoce nuestras soluciones: soluciones tecnológicas de conectividad, ciberseguridad, data center y servicios gestionados respaldadas por la red 100% fibra óptica de Fiberlux Corp."
  footerOverlap
>
  <main class="bg-fx-bg">
    <PageHero
      crumb={tField(page, "breadcrumb", locale)}
      title={tField(page, "heading", locale)}
      subtitle={tField(page, "intro", locale)}
      locale={locale}
      variant="soft"
    />
    <HomeSolucionesReact client:visible {...homeProps} />
    <HomePartnersV2 locale={locale} />
    <HomeCertificacionesReact client:visible {...homeProps} certificaciones={certificaciones} />
    <ServiceFormSection client:visible form={serviciosForm} locale={locale} />
  </main>
</BaseLayout>
