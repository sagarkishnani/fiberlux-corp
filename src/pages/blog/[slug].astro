---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { client } from '../../../tina/__generated__/client';
import ArticleV2React from '../../components/blog/ArticleV2React';
import { byDateDesc, toPostSummary } from '../../utils/postMeta';
import { getLocale } from '../../utils/i18n';
import { isLocale } from '../../i18n/config';

export async function getStaticPaths() {
  try {
    const postsQuery = await client.queries.postConnection({ last: 100 });
    return (postsQuery.data?.postConnection?.edges || [])
      .filter((e: any) => e?.node)
      .map((e: any) => ({ params: { slug: e.node._sys.filename } }));
  } catch {
    return [];
  }
}

const { slug } = Astro.params;
const postQuery = await client.queries.post({ relativePath: `${slug}.mdx` });
const currentPost = postQuery.data?.post;

let related: ReturnType<typeof toPostSummary>[] = [];
try {
  const allPostsQuery = await client.queries.postConnection({ sort: 'date', last: 100 });
  const currentTags = (currentPost?.tags || []).filter(Boolean) as string[];
  related = ((allPostsQuery.data?.postConnection?.edges || []) as any[])
    .map((e) => e?.node)
    .filter((node) => node && node._sys.filename !== slug)
    .map((node) => ({
      summary: toPostSummary(node),
      score: ((node.tags || []) as string[]).filter((tag) => currentTags.includes(tag)).length,
    }))
    .sort((a, b) => b.score - a.score || byDateDesc(a.summary, b.summary))
    .slice(0, 3)
    .map((r) => r.summary);
} catch {
  related = [];
}

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocale(Astro.url);
const pageTitle = currentPost?.title || 'Blog';
const pageDescription = currentPost?.excerpt || 'Lee nuestro artículo sobre tecnología y conectividad empresarial';
---

<BaseLayout title={pageTitle} description={pageDescription} footerOverlap>
  <main class="bg-fx-bg">
    <ArticleV2React
      client:load
      query={postQuery.query}
      variables={postQuery.variables}
      data={postQuery.data}
      locale={locale}
      related={related}
    />
  </main>
</BaseLayout>
