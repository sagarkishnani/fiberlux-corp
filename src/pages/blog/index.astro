---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { client } from '../../../tina/__generated__/client';
import BlogV2React from '../../components/blog/BlogV2React';
import { byDateDesc, toPostSummary } from '../../utils/postMeta';
import { getLocale } from '../../utils/i18n';
import { isLocale } from '../../i18n/config';

let posts: ReturnType<typeof toPostSummary>[] = [];
try {
  const postsQuery = await client.queries.postConnection({ sort: 'date', last: 100 });
  posts = ((postsQuery.data?.postConnection?.edges || []) as any[])
    .map((e) => e?.node)
    .filter(Boolean)
    .map(toPostSummary)
    .sort(byDateDesc);
} catch {
  posts = [];
}
const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocale(Astro.url);
---

<BaseLayout title="Blog" description="Insights, novedades y tendencias en conectividad y tecnología empresarial" footerOverlap>
  <main class="bg-fx-bg">
    <BlogV2React client:load posts={posts} locale={locale} />
  </main>
</BaseLayout>
