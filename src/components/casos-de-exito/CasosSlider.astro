---
import { client } from "../../../tina/__generated__/client";
import CasosSliderReact from "./CasosSliderReact.tsx";
import { getLocale } from "../../utils/i18n";
import { isLocale } from "../../i18n/config";

const casosQuery = await client.queries.casosDeExito({
  relativePath: "index.json",
});
const globalQuery = await client.queries.global({ relativePath: "index.json" });
const cfg = (globalQuery.data?.global as any)?.sliders?.casos ?? {};
const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocale(Astro.url);
---

<CasosSliderReact
  client:visible
  query={casosQuery.query}
  variables={casosQuery.variables}
  data={casosQuery.data}
  autoplay={cfg.autoplay ?? true}
  intervalMs={cfg.intervalMs ?? 6000}
  effect={cfg.effect ?? "scale"}
  locale={locale}
/>
