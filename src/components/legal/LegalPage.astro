---
import { client } from "../../../tina/__generated__/client";
import LegalPageReact from "./LegalPageReact.tsx";
import DynamicForm from "../dynamic-form/DynamicForm.astro";
import { getLocale } from "../../utils/i18n";
import { isLocale } from "../../i18n/config";

interface Props {
  slug: string;
}

const { slug } = Astro.props;

const result = await client.queries.legal({ relativePath: `${slug}.json` });
const embeddedFormSlug = result.data?.legal?.embeddedFormSlug;
const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocale(Astro.url);
---

<div class="pb-[67px] lg:pb-40">
  <LegalPageReact
    client:load
    query={result.query}
    variables={result.variables}
    data={result.data}
    locale={locale}
    hasForm={!!embeddedFormSlug}
  />

  {
    embeddedFormSlug && (
      <div class="fx-container mt-5">
        <div class="mx-auto max-w-[1000px]">
          <DynamicForm formSlug={embeddedFormSlug} />
        </div>
      </div>
    )
  }
</div>
