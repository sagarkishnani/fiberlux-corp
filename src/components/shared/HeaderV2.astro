---
/**
 * HeaderV2 wrapper — fetches global data from TinaCMS.
 * New header (SPEC 33): top bar (Empresas / Negocios / abonados) + inline
 * desktop navbar with hover reveal. The hamburger is mobile-only (hidden on
 * desktop, SPEC 38) and opens the full multilevel nav; legales live only in
 * the footer, not in the hamburger overlay.
 * Uses client:load because it needs JS for menu, hover and scroll behavior.
 */
import { client } from '../../../tina/__generated__/client';
import HeaderV2React from './HeaderV2React.tsx';
import type { Locale } from '../../i18n/config';

interface Props {
  theme?: 'light' | 'dark';
  /** Solo la home activa el logo grande animado del hero (SPEC 39). */
  heroLogo?: boolean;
  /** Alineación del logo en estado hero: 'center' (SPEC 88) o 'left' (morph, SPEC 96). */
  heroLogoAlign?: 'center' | 'left';
  /** Fondo opaco/blur desde el inicio (páginas con hero de imagen). */
  solidOnLoad?: boolean;
  /** Idioma activo (SPEC 80). */
  locale?: Locale;
  /** Glow neón en el logo grande del hero (modo cinematic, SPEC 97). */
}

const { theme = 'dark', heroLogo = false, heroLogoAlign = 'center', solidOnLoad = false, locale = 'es' } = Astro.props;

const globalQuery = await client.queries.global({ relativePath: 'index.json' });
---

<HeaderV2React
  client:load
  query={globalQuery.query}
  variables={globalQuery.variables}
  data={globalQuery.data}
  theme={theme}
  heroLogo={heroLogo}
  heroLogoAlign={heroLogoAlign}
  solidOnLoad={solidOnLoad}
  locale={locale}
  currentPath={Astro.url.pathname}
/>
