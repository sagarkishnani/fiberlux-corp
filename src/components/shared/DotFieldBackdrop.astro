---
/**
 * DotFieldBackdrop — telón de fondo con el campo de puntos (SPEC 100).
 *
 * Envuelve una sección del home y monta `DotWaveField` en variante `section`
 * por detrás de su contenido. Se aplica SOLO desde `src/pages/index.astro`:
 * las secciones que envuelve (`SolucionesStack`, `BannerApp`) se reutilizan en
 * otras páginas y ahí no deben cambiar.
 *
 * Ojo: la sección envuelta tiene que renderizar con fondo transparente (prop
 * `transparentBg`), o su propio `bg-*` opaco tapa el campo.
 */
import DotWaveField from "../effects/DotWaveField";

interface Props {
  /** Preset de densidad/brillo. Debe coincidir con el del hero. */
  intensity?: "sutil" | "medio" | "intenso";
  class?: string;
}

const { intensity = "medio", class: className } = Astro.props;
---

<div class:list={["relative bg-greyscale-darkest", className]}>
  <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
    <DotWaveField
      client:visible
      variant="section"
      intensity={intensity}
      className="h-full w-full"
    />
  </div>
  <div class="relative z-10"><slot /></div>
</div>
