---
import { client } from '../../../tina/__generated__/client';
import HeaderV3React from './HeaderV3React.tsx';
import type { Locale } from '../../i18n/config';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;

const globalQuery = await client.queries.global({ relativePath: 'index.json' });
---

<HeaderV3React
  client:load
  query={globalQuery.query}
  variables={globalQuery.variables}
  data={globalQuery.data}
  locale={locale}
  currentPath={Astro.url.pathname}
/>
