---
import client from "../../../tina/__generated__/client";
import DynamicFormReact from "./DynamicFormReact";
import { getLocale } from "../../utils/i18n";
import { isLocale } from "../../i18n/config";

interface Props {
  formSlug: string;
  prefill?: Record<string, string>;
}

const { formSlug, prefill } = Astro.props;

const result = await client.queries.dynamicForms({
  relativePath: `${formSlug}.json`,
});
const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocale(Astro.url);
---

<DynamicFormReact
  query={result.query}
  variables={result.variables}
  data={result.data}
  prefill={prefill}
  locale={locale}
  client:load
/>
