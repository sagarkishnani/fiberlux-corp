---
import { client } from "../../../tina/__generated__/client";
import HeroSoporteReact from "./HeroSoporteReact.tsx";
import { getLocale } from "../../utils/i18n";
import { isLocale } from "../../i18n/config";

const soporteQuery = await client.queries.soporteTecnico({
  relativePath: "index.json",
});
const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocale(Astro.url);
---

<HeroSoporteReact
  client:load
  query={soporteQuery.query}
  variables={soporteQuery.variables}
  data={soporteQuery.data}
  locale={locale}
/>
