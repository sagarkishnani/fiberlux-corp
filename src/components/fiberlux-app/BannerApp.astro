---
/**
 * BannerApp — banner promocional reutilizable de la Fiberlux App (SPEC 53).
 * Se alimenta del objeto `banner` de la colección `fiberluxApp`. Reutilizable:
 * insértalo en cualquier página con `<BannerApp />`.
 */
import { client } from "../../../tina/__generated__/client";
import BannerAppReact from "./BannerAppReact.tsx";
import { getLocale } from "../../utils/i18n";
import { isLocale } from "../../i18n/config";

const appQuery = await client.queries.fiberluxApp({
  relativePath: "index.json",
});
const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocale(Astro.url);

// SPEC 100: el home puede pedir el banner sin fondo propio para que se vea el
// campo de puntos del contenedor. Por defecto, fondo de siempre.
const { transparentBg = false } = Astro.props;
---

<BannerAppReact
  client:visible
  query={appQuery.query}
  variables={appQuery.variables}
  data={appQuery.data}
  locale={locale}
  transparentBg={transparentBg}
/>
