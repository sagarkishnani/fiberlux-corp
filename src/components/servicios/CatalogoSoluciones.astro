---
import { client } from "../../../tina/__generated__/client";
import CatalogoSolucionesReact from "./CatalogoSolucionesReact.tsx";

interface Props {
  relativePath: string;
}

const { relativePath } = Astro.props;
const serviceQuery = await client.queries.service({ relativePath });
const globalQuery = await client.queries.global({ relativePath: "index.json" });
const cfg = (globalQuery.data?.global as any)?.sliders?.catalogoSoluciones ?? {};
---

<CatalogoSolucionesReact
  client:visible
  query={serviceQuery.query}
  variables={serviceQuery.variables}
  data={serviceQuery.data}
  autoplay={cfg.autoplay ?? true}
  intervalMs={cfg.intervalMs ?? 6000}
  effect={cfg.effect ?? "none"}
/>
