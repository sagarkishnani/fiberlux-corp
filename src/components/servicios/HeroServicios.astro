---
import { client } from "../../../tina/__generated__/client";
import HeroServiciosReact from "./HeroServiciosReact.tsx";
import { getLocale } from "../../utils/i18n";
import { isLocale } from "../../i18n/config";

const serviciosQuery = await client.queries.servicios({
  relativePath: "index.json",
});

const locale = isLocale(Astro.currentLocale)
  ? Astro.currentLocale
  : getLocale(Astro.url);
---

<HeroServiciosReact
  client:load
  query={serviciosQuery.query}
  variables={serviciosQuery.variables}
  data={serviciosQuery.data}
  locale={locale}
/>
