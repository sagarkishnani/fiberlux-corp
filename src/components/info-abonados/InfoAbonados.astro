---
import client from "../../../tina/__generated__/client";
import InfoAbonadosReact from "./InfoAbonadosReact";
import { getLocale } from "../../utils/i18n";
import { isLocale } from "../../i18n/config";

const result = await client.queries.infoAbonados({ relativePath: "index.json" });
const locale = isLocale(Astro.currentLocale)
  ? Astro.currentLocale
  : getLocale(Astro.url);
---

<InfoAbonadosReact
  query={result.query}
  variables={result.variables}
  data={result.data}
  locale={locale}
  client:visible
/>
