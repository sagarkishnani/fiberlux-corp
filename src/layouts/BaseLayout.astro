---
import Footer from "../components/shared/Footer.astro";
// Header antiguo — reemplazado por HeaderV2 (SPEC 33). Se deja comentado por si acaso.
// import Header from "../components/shared/Header.astro";
import HeaderV2 from "../components/shared/HeaderV2.astro";
import CookieConsent from "../components/cookies/CookieConsent.astro";
import WhatsAppButton from "../components/shared/WhatsAppButton.tsx";
import AccessibilityPanel from "../components/shared/AccessibilityPanel.tsx";
import CursorTrail from "../components/shared/CursorTrail.tsx";
import client from "../../tina/__generated__/client";
import homeContent from "../content/home/index.json";
import "../styles/site-container.css";
import { getLocale } from "../utils/i18n";
import { isLocale } from "../i18n/config";

// ─── Locale (SPEC 80) ───
// Preferimos Astro.currentLocale (lo setea el routing i18n, incl. rutas /en de
// fallback) y caemos a derivarlo del path. Se pasa como prop a los componentes
// para no depender de currentLocale dentro de las islas.
const locale = isLocale(Astro.currentLocale)
  ? Astro.currentLocale
  : getLocale(Astro.url);

interface Props {
  title?: string;
  description?: string;
  headerTheme?: "light" | "dark";
  /** Nombre del servicio/solución para personalizar el mensaje de WhatsApp. */
  whatsappContext?: string;
  /** Tipo de página para el mensaje de WhatsApp. */
  whatsappKind?: "servicio" | "solución";
}

const {
  title = "Fiberlux",
  description = "Soluciones de conectividad y TI para tu empresa",
  headerTheme = "dark",
  whatsappContext,
  whatsappKind = "servicio",
} = Astro.props;

// ─── Home detection (SPEC 39) ───
// El logo grande animado del hero (que vuela al header con el scroll) solo aplica
// en la home. BASE_URL-aware para que funcione si el sitio se despliega en subpath.
const normalizePath = (p: string) => p.replace(/\/+$/, "") || "/";
const isHome =
  normalizePath(Astro.url.pathname) === normalizePath(import.meta.env.BASE_URL);
// En el modo de hero "morph" (SPEC 96) el hero es texto-izquierda + globo, así
// que el logo grande animado del header (SPEC 39) se alinea a la IZQUIERDA en
// vez de al centro (SPEC 88). Conserva la animación de subir al header al hacer
// scroll.
const homeHeroMorph =
  isHome && (homeContent as any)?.hero?.heroBackground === "morph";
// Modo de hero "cinematic" (SPEC 97): entrada coreografiada — el header se
// revela de a pocos. La clase se aplica desde el SSR para que no haya parpadeo.
const homeHeroCinematic =
  isHome && (homeContent as any)?.hero?.heroBackground === "cinematic";
// Páginas de solución (categoría + subservicio) y fiberlux-app tienen hero de
// imagen: el header arranca con fondo opaco/blur para que el menú no se pierda
// sobre la imagen (zonas claras de la foto se mezclaban con el texto blanco).
// Las páginas de tema claro (legales, reclamos, etc.) también arrancan sólidas:
// con el header transparente, su barra dejaba ver el negro del body detrás
// (franja negra bajo la topbar antes de hacer scroll).
const solidHeader =
  headerTheme === "light" ||
  /\/soluciones\/[^/]+/.test(Astro.url.pathname) ||
  /\/fiberlux-app\/?$/.test(Astro.url.pathname);

// ─── Maintenance mode check ───
let maintenanceMode = false;
let maintenanceData: any = null;
try {
  const maintenanceResult = await client.queries.maintenance({
    relativePath: "index.json",
  });
  maintenanceData = maintenanceResult.data?.maintenance;
  maintenanceMode = maintenanceData?.enabled === true;
} catch {
  // If collection doesn't exist yet, continue normally
}

// ─── WhatsApp floating button config (editable in Tina: global.whatsapp) ───
// ─── Global code injection (editable in Tina: global.codeInjection) ───
let whatsappPhone: string | undefined;
let whatsappBaseMessage: string | undefined;
let injectHead = "";
let injectBodyEnd = "";
try {
  const globalResult = await client.queries.global({ relativePath: "index.json" });
  const g = globalResult.data?.global as any;
  const wa = g?.whatsapp;
  whatsappPhone = wa?.phone || undefined;
  whatsappBaseMessage = wa?.message || undefined;
  injectHead = g?.codeInjection?.head || "";
  injectBodyEnd = g?.codeInjection?.bodyEnd || "";
} catch {
  // Fall back to the component defaults
}

// On service/solution pages the message references that specific service;
// elsewhere it uses the editable base message from the CMS.
const whatsappMessage = whatsappContext
  ? `¡Hola Fiberlux! Deseo información sobre ${
      whatsappKind === "solución" ? "la solución" : "el servicio"
    } de ${whatsappContext}.`
  : whatsappBaseMessage;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={maintenanceMode ? "Sitio en mantenimiento" : description}
    />
    <link rel="icon" type="image/svg+xml" href="/fiberlux-favicon.png" />
    {/* Fuentes: Poppins es la tipografía de marca (font-sans en Tailwind). Se
        carga aquí porque el @import en global.css NUNCA se bundlea — sin esto el
        sitio cae al font del sistema y se ve distinto en cada dispositivo.
        Atkinson Hyperlegible la usa el panel de accesibilidad (dislexia). */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600;1,700&family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&display=swap"
    />
    <title>
      {maintenanceMode ? "Mantenimiento | Fiberlux" : `${title} | Fiberlux`}
    </title>
    {/* Reveal (SPEC 69): marca <html class="reveal-js"> ANTES del primer paint
        para ocultar los [data-reveal] solo cuando hay JS (anti-FOUC). */}
    <script is:inline>
      document.documentElement.classList.add("reveal-js");
    </script>
    <style is:global>
      /* Guard anti scroll horizontal: los reveals con desplazamiento horizontal
         (data-reveal="left|right", y el scrub que se aleja ×1.7 al salir) trasladan
         elementos hasta ~170px fuera del viewport, generando scroll horizontal
         hasta que el reveal se asienta. Se recorta en el wrapper de contenido
         (elemento no-root; el root `html` no propaga `clip` al viewport). `clip`
         no crea scroll-container (no rompe position:sticky, Lenis ni los carruseles
         con su propio overflow) y no afecta al header fixed ni al scroll vertical. */
      #a11y-content {
        overflow-x: clip;
      }
      .reveal-js [data-reveal]:not([data-reveal-stagger]) {
        opacity: 0;
        will-change: transform, opacity;
      }
      .reveal-js [data-reveal="up"]:not([data-reveal-stagger]) { transform: translateY(80px); }
      .reveal-js [data-reveal="down"]:not([data-reveal-stagger]) { transform: translateY(-80px); }
      .reveal-js [data-reveal="left"]:not([data-reveal-stagger]) { transform: translateX(-80px); }
      .reveal-js [data-reveal="right"]:not([data-reveal-stagger]) { transform: translateX(80px); }
      .reveal-js [data-reveal="scale"]:not([data-reveal-stagger]) { transform: scale(0.94); }
      .reveal-js [data-reveal="diag-ur"]:not([data-reveal-stagger]) { transform: translate(-80px, 80px); }
      .reveal-js [data-reveal="diag-ul"]:not([data-reveal-stagger]) { transform: translate(80px, 80px); }
      .reveal-js [data-reveal="diag-dr"]:not([data-reveal-stagger]) { transform: translate(-80px, -80px); }
      .reveal-js [data-reveal="diag-dl"]:not([data-reveal-stagger]) { transform: translate(80px, -80px); }
      .reveal-js [data-reveal-stagger] > * { opacity: 0; }
      @media (prefers-reduced-motion: reduce) {
        .reveal-js [data-reveal],
        .reveal-js [data-reveal-stagger] > * {
          opacity: 1 !important;
          transform: none !important;
        }
      }
      /* Guard anti-FOUC del panel de accesibilidad: la isla React que lo estiliza
         carga con client:idle y su <style> vive al final del <body>. En teléfonos
         que pintan el markup antes de parsear ese <style>, el panel aparecía un
         instante en su posición "abierta" y luego se deslizaba fuera (flash de
         ~300ms al navegar). Este CSS crítico en el <head> se parsea ANTES del
         primer paint y lo deja oculto desde el inicio; `.is-open` (más específico)
         lo vuelve visible cuando el usuario lo abre. */
      .a11y-panel {
        position: fixed;
        top: 0;
        left: 0;
        transform: translateX(-105%);
      }
      .a11y-backdrop {
        position: fixed;
        inset: 0;
        opacity: 0;
        visibility: hidden;
      }
      /* Hero cinematic (SPEC 97): el header se revela de a pocos al cargar.
         Aplicado desde el SSR (clase en el wrapper) para no parpadear. */
      .cine-intro-page header {
        animation: cine-header-in 1100ms ease-out 200ms both;
      }
      @keyframes cine-header-in {
        from { opacity: 0; }
        to { opacity: 1; }
      }
      @media (prefers-reduced-motion: reduce) {
        .cine-intro-page header { animation: none; }
      }
    </style>
    {/* Accessibility: apply saved preferences before first paint (no flash) */}
    <script is:inline>
      (function () {
        try {
          var s = JSON.parse(
            localStorage.getItem("fiberlux-a11y-v1") || "{}"
          );
          var r = document.documentElement;
          if (s.fontScale) {
            r.style.setProperty("--a11y-font-scale", String(s.fontScale));
            if (s.fontScale !== 1) r.classList.add("a11y-scaled");
          }
          if (s.letterSpacing)
            r.style.setProperty(
              "--a11y-letter-spacing",
              s.letterSpacing + "em"
            );
          // Contraste (obs11): niveles 0=off,1=bajo,2=medio,3=alto. Mismos
          // valores que CONTRAST_LEVELS en AccessibilityPanel.tsx.
          var CL = [[1, 1], [0.7, 1], [0.85, 1], [1.4, 1.03]];
          var lvl = s.contrastLevel != null
            ? s.contrastLevel
            : (s.contrast ? 3 : 0);
          if (lvl > 0 && CL[lvl]) {
            r.style.setProperty("--a11y-contrast", String(CL[lvl][0]));
            r.style.setProperty("--a11y-brightness", String(CL[lvl][1]));
          }
          if (s.saturation) r.style.setProperty("--a11y-saturate", "0.12");
          if (s.invert) {
            r.style.setProperty("--a11y-invert", "1");
            r.style.setProperty("--a11y-hue", "180deg");
          }
          if (lvl > 0 || s.saturation || s.invert)
            r.classList.add("a11y-filter");
          if (s.hideImages) r.classList.add("a11y-hide-images");
          if (s.dyslexia) r.classList.add("a11y-dyslexia");
        } catch (e) {}
      })();
    </script>
    {/* Scripts globales editables en Tina (global.codeInjection.head).
        No se inyectan en modo mantenimiento. */}
    {!maintenanceMode && injectHead && <Fragment set:html={injectHead} />}
  </head>
  <body>
    {
      maintenanceMode ? (
        <main style="background: linear-gradient(180deg, #96237A 0%, #650F50 100%); min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: space-between; text-align: center; padding: 0 20px;">
          <div style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; max-width: 520px;">
            <img
              src="/images/logo/fiberlux.svg"
              alt="Fiberlux"
              style="height: clamp(28px, 5vw, 40px); margin-bottom: clamp(28px, 5vw, 48px); opacity: 0.9; filter: brightness(0) invert(1);"
            />

            <div style="width: clamp(56px, 12vw, 72px); height: clamp(56px, 12vw, 72px); border-radius: 50%; background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; margin-bottom: clamp(20px, 4vw, 28px);">
              <svg
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                style="width: clamp(24px, 5vw, 32px); height: clamp(24px, 5vw, 32px);"
              >
                <path
                  d="M12 15V17M6 21H18C18.5304 21 19.0391 20.7893 19.4142 20.4142C19.7893 20.0391 20 19.5304 20 19V13C20 12.4696 19.7893 11.9609 19.4142 11.5858C19.0391 11.2107 18.5304 11 18 11H6C5.46957 11 4.96086 11.2107 4.58579 11.5858C4.21071 11.9609 4 12.4696 4 13V19C4 19.5304 4.21071 20.0391 4.58579 20.4142C4.96086 20.7893 5.46957 21 6 21ZM16 11V7C16 5.93913 15.5786 4.92172 14.8284 4.17157C14.0783 3.42143 13.0609 3 12 3C10.9391 3 9.92172 3.42143 9.17157 4.17157C8.42143 4.92172 8 5.93913 8 7V11H16Z"
                  stroke="white"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>

            <h1 style="font-family: Poppins, sans-serif; font-weight: 700; color: #fff; margin: 0 0 16px; font-size: clamp(24px, 6vw, 44px); line-height: 1.2;">
              {maintenanceData?.title || "Estamos en mantenimiento"}
            </h1>

            <p style="font-family: Poppins, sans-serif; color: rgba(255,255,255,0.7); margin: 0 0 clamp(28px, 5vw, 40px); font-size: clamp(14px, 3vw, 18px); line-height: 1.7; max-width: 480px;">
              {
                maintenanceData?.message ||
                  "Estamos realizando mejoras para ofrecerte una mejor experiencia. Volveremos pronto."
              }
            </p>

            {maintenanceData?.showContact && maintenanceData?.contactText && (
              <a
                href={maintenanceData.contactUrl || "#"}
                style="display: inline-flex; align-items: center; justify-content: center; padding: 14px 32px; border-radius: 999px; background: #fff; color: #650F50; font-family: Poppins, sans-serif; font-size: clamp(13px, 2.5vw, 15px); font-weight: 600; text-decoration: none; transition: all 0.2s; box-shadow: 0 4px 16px rgba(0,0,0,0.1);"
              >
                {maintenanceData.contactText}
              </a>
            )}
          </div>

          <p style="font-family: Poppins, sans-serif; color: rgba(255,255,255,0.35); font-size: 11px; padding-bottom: clamp(20px, 4vw, 32px);">
            © 2026 Fiberlux. Todos los derechos reservados
          </p>
        </main>
      ) : (
        <Fragment>
          {/* Page content — the accessibility color filter is applied here so
              the fixed overlays below stay reachable while a filter is on. */}
          <div id="a11y-content" class:list={[{ "cine-intro-page": homeHeroCinematic }]}>
            {/* <Header theme={headerTheme} /> */}
            <HeaderV2 theme={headerTheme} heroLogo={isHome} heroLogoAlign={homeHeroMorph ? "left" : "center"} solidOnLoad={solidHeader} locale={locale} />
            <slot />
            <div class="-mt-6 relative z-40">
              <Footer locale={locale} />
            </div>
          </div>
          <CookieConsent />
          <WhatsAppButton
            client:idle
            phone={whatsappPhone}
            message={whatsappMessage}
          />
          <AccessibilityPanel client:idle locale={locale} />
          {/* Estela luminosa que sigue al cursor (toda la web, solo desktop). */}
          <CursorTrail client:idle />
          {/* Scripts globales editables en Tina (global.codeInjection.bodyEnd). */}
          {injectBodyEnd && <Fragment set:html={injectBodyEnd} />}
        </Fragment>
      )
    }
  </body>
</html>

{/* Reveal (SPEC 69): animaciones de entrada por [data-reveal]. */}
{!maintenanceMode && <script>import "../scripts/reveal.ts";</script>}

{/* Overlap sticky del hero (SPEC 70): efecto al ser cubierto. */}
{!maintenanceMode && <script>import "../scripts/heroOverlap.ts";</script>}

{/* FX de scroll (SPEC 71): count-up y parallax. */}
{!maintenanceMode && <script>import "../scripts/fx.ts";</script>}

{
  !maintenanceMode && (
    <script>
      import Lenis from "lenis";

      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true,
      });

      // Expuesto para que overlays (ej. búsqueda) puedan pausar/reanudar el
      // smooth-scroll y bloquear el fondo mientras están abiertos (SPEC 81).
      (window as any).__lenis = lenis;

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }

      requestAnimationFrame(raf);

      // Smooth-scroll in-page anchor links (e.g. "Ver soluciones" → #catalogo)
      // through Lenis instead of the browser's instant jump. Offset leaves room
      // for the fixed header.
      document.addEventListener("click", (e) => {
        const link = (e.target as HTMLElement)?.closest?.(
          'a[href*="#"]'
        ) as HTMLAnchorElement | null;
        if (!link) return;

        const url = new URL(link.href, window.location.href);
        // Only handle same-page hashes.
        if (
          url.pathname !== window.location.pathname ||
          url.search !== window.location.search
        )
          return;

        const id = decodeURIComponent(url.hash.slice(1));
        if (!id) return;
        const target = document.getElementById(id);
        if (!target) return;

        e.preventDefault();
        lenis.scrollTo(target, { offset: -80 });
        history.pushState(null, "", url.hash);
      });
    </script>
  )
}
